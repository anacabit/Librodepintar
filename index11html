/* =====================================================
   ESTADO
===================================================== */

let currentColor=COLORS[0];

let isEraser=false;

let currentIdx=0;

const colors=DRAWINGS.map(
d=>d.zones.map(()=>'white')
);


/* =====================================================
   CANVAS
===================================================== */

const canvas=document.getElementById('paint-canvas');

const ctx=canvas.getContext('2d');

const STROKE='#222';

const STROKE_W=2.5;

const DECO_STROKE='#555';

const DECO_W=1.5;

const LOGIC=300;


/* =====================================================
   TAMAÑO
===================================================== */

function resizeCanvas(){

const max=560;

const available=Math.min(
window.innerWidth-16,
max
);

canvas.width=available;

canvas.height=available;

canvas.style.width=available+'px';

canvas.style.height=available+'px';

redraw();

}


function scale(){

return canvas.width/LOGIC;

}


/* =====================================================
   TRANSFORMACIÓN
   CORREGIDA
===================================================== */

function applyTransform(t,sc){

const m=t.match(
/rotate\(([\d.-]+),([\d.-]+),([\d.-]+)\)/
);

if(!m)return;

const ang=parseFloat(m[1])*Math.PI/180;

const cx=parseFloat(m[2])*sc;

const cy=parseFloat(m[3])*sc;

ctx.translate(cx,cy);

ctx.rotate(ang);

ctx.translate(-cx,-cy);

}


/* =====================================================
   DIBUJAR ELEMENTO
===================================================== */

function drawEl(el,fillColor,isDeco){

const sc=scale();

const A=el.a;

ctx.save();

if(A.transform){
applyTransform(A.transform,sc);
}

ctx.beginPath();


if(el.t==='ellipse'){

ctx.ellipse(
A.cx*sc,
A.cy*sc,
A.rx*sc,
A.ry*sc,
0,
0,
Math.PI*2
);

}


else if(el.t==='circle'){

ctx.arc(
A.cx*sc,
A.cy*sc,
A.r*sc,
0,
Math.PI*2
);

}


else if(el.t==='rect'){

const r=(A.rx||0)*sc;

if(r>0){

ctx.roundRect(
A.x*sc,
A.y*sc,
A.width*sc,
A.height*sc,
r
);

}else{

ctx.rect(
A.x*sc,
A.y*sc,
A.width*sc,
A.height*sc
);

}

}


else if(el.t==='polygon'){

const pts=A.points
.split(' ')
.map(p=>p.split(',').map(Number));

ctx.moveTo(
pts[0][0]*sc,
pts[0][1]*sc
);

pts.slice(1).forEach(p=>{
ctx.lineTo(
p[0]*sc,
p[1]*sc
);
});

ctx.closePath();

}


else if(el.t==='path'){

try{

const path=new Path2D(A.d);

ctx.save();

ctx.scale(sc,sc);

if(isDeco){

ctx.strokeStyle=DECO_STROKE;
ctx.lineWidth=DECO_W;
ctx.lineCap='round';
ctx.lineJoin='round';
ctx.stroke(path);

}else{

ctx.fillStyle=fillColor;
ctx.fill(path);

ctx.strokeStyle=STROKE;
ctx.lineWidth=STROKE_W;
ctx.lineCap='round';
ctx.lineJoin='round';
ctx.stroke(path);

}

ctx.restore();

ctx.restore();

return;

}catch(e){

console.warn('Path no compatible:',A.d);

}

}


else if(el.t==='line'){

ctx.moveTo(
A.x1*sc,
A.y1*sc
);

ctx.lineTo(
A.x2*sc,
A.y2*sc
);

}


/* DIBUJO NORMAL */

if(isDeco){

ctx.strokeStyle=DECO_STROKE;

ctx.lineWidth=DECO_W*sc;

ctx.lineCap='round';

ctx.lineJoin='round';

ctx.stroke();

}else{

ctx.fillStyle=fillColor;

ctx.fill();

ctx.strokeStyle=STROKE;

ctx.lineWidth=STROKE_W*sc;

ctx.lineCap='round';

ctx.lineJoin='round';

ctx.stroke();

}

ctx.restore();

}


/* =====================================================
   REDIBUJAR
===================================================== */

function redraw(){

const d=DRAWINGS[currentIdx];

ctx.clearRect(
0,
0,
canvas.width,
canvas.height
);

ctx.fillStyle='white';

ctx.fillRect(
0,
0,
canvas.width,
canvas.height
);

d.zones.forEach(
(el,i)=>
drawEl(
el,
colors[currentIdx][i],
false
)
);

(d.decos||[]).forEach(
el=>
drawEl(
el,
'none',
true
)
);

}


/* =====================================================
   TRANSFORMACIÓN INVERSA
===================================================== */

function inverseTransformPoint(A,x,y){

if(!A.transform){
return {x,y};
}

const m=A.transform.match(
/rotate\(([\d.-]+),([\d.-]+),([\d.-]+)\)/
);

if(!m){
return {x,y};
}

const ang=
-parseFloat(m[1])*Math.PI/180;

const cx=parseFloat(m[2]);

const cy=parseFloat(m[3]);

const dx=x-cx;

const dy=y-cy;

return{

x:
cx+
dx*Math.cos(ang)-
dy*Math.sin(ang),

y:
cy+
dx*Math.sin(ang)+
dy*Math.cos(ang)

};

}


/* =====================================================
   ZONA PATH REAL
===================================================== */

function pointInPathExact(
d,
x,
y
){

try{

const path=new Path2D(d);

return ctx.isPointInPath(
path,
x,
y
);

}catch(e){

return false;

}

}


/* =====================================================
   POLÍGONO
===================================================== */

function pointInPolygon(x,y,pts){

let inside=false;

for(
let i=0,
j=pts.length-1;

i<pts.length;

j=i++
){

const xi=pts[i][0];
const yi=pts[i][1];

const xj=pts[j][0];
const yj=pts[j][1];

if(
((yi>y)!=(yj>y)) &&
(
x<
(xj-xi)*
(y-yi)/
(yj-yi)+
xi
)
){

inside=!inside;

}

}

return inside;

}


/* =====================================================
   DETECTAR ZONA
===================================================== */

function isInZone(el,x,y){

const A=el.a;

const p=inverseTransformPoint(
A,
x,
y
);

const tx=p.x;
const ty=p.y;


/* ELIPSE */

if(el.t==='ellipse'){

const dx=(tx-A.cx)/A.rx;

const dy=(ty-A.cy)/A.ry;

return dx*dx+dy*dy<=1;

}


/* CÍRCULO */

if(el.t==='circle'){

const dx=tx-A.cx;

const dy=ty-A.cy;

return dx*dx+dy*dy<=A.r*A.r;

}


/* RECT */

if(el.t==='rect'){

return(
tx>=A.x &&
tx<=A.x+A.width &&
ty>=A.y &&
ty<=A.y+A.height
);

}


/* POLÍGONO */

if(el.t==='polygon'){

return pointInPolygon(
tx,
ty,
A.points
.split(' ')
.map(
p=>p.split(',').map(Number)
)
);

}


/* PATH */

if(el.t==='path'){

return pointInPathExact(
A.d,
tx,
ty
);

}

return false;

}


/* =====================================================
   HIT ZONE
===================================================== */

function hitZone(px,py){

const d=DRAWINGS[currentIdx];

const sc=scale();

const x=px/sc;
const y=py/sc;


/*
 Se comprueba desde arriba hacia abajo.
 La última zona está visualmente encima.
*/

for(
let i=d.zones.length-1;
i>=0;
i--
){

if(
isInZone(
d.zones[i],
x,
y
)
){

return i;

}

}

return -1;

}


/* =====================================================
   POSICIÓN
===================================================== */

function getPos(e){

const r=
canvas.getBoundingClientRect();

const src=e.touches?
e.touches[0]:
e;

return{

x:src.clientX-r.left,

y:src.clientY-r.top

};

}


/* =====================================================
   PINTAR
===================================================== */

function handlePaint(e){

if(e.cancelable){
e.preventDefault();
}

const p=getPos(e);

const zi=hitZone(
p.x,
p.y
);

if(zi<0)return;

colors[currentIdx][zi]=
isEraser?
'white':
currentColor;

redraw();

}


/* =====================================================
   EVENTOS
===================================================== */

canvas.addEventListener(
'click',
handlePaint
);

canvas.addEventListener(
'touchstart',
handlePaint,
{passive:false}
);


/* =====================================================
   GALERÍA
===================================================== */

const gallery=
document.getElementById('gallery');


function buildMiniSVG(d){

const ns=
'http://www.w3.org/2000/svg';

let s=
`<svg
viewBox="${d.vb}"
xmlns="${ns}"
width="50"
height="50">`;

d.zones.forEach(el=>{

/*
 El fondo se muestra también
 en la miniatura.
*/

if(el.t==='path'){

s+=
`<path
d="${el.a.d}"
fill="white"
stroke="#333"
stroke-width="3"
stroke-linecap="round"
stroke-linejoin="round"/>`;

return;

}

s+=
`<${el.t}
fill="white"
stroke="#333"
stroke-width="3"
stroke-linecap="round"
stroke-linejoin="round"`;

Object.entries(el.a).forEach(
([k,v])=>{
s+=` ${k}="${v}"`;
}
);

s+='/>';

});

return s+'</svg>';

}


DRAWINGS.forEach(
(d,i)=>{

const thumb=
document.createElement('div');

thumb.className=
'thumb'+
(i===0?' active':'');

thumb.innerHTML=
buildMiniSVG(d);

thumb.addEventListener(
'click',
()=>{

document
.querySelectorAll('.thumb')
.forEach(
t=>
t.classList.remove('active')
);

thumb.classList.add('active');

currentIdx=i;

document
.getElementById('drawing-label')
.textContent=d.name;

redraw();

}
);

gallery.appendChild(thumb);

}
);


/* =====================================================
   PALETA
===================================================== */

const palEl=
document.getElementById('palette');


COLORS.forEach(
(c,i)=>{

const btn=
document.createElement('button');

btn.className=
'cbtn'+
(i===0?' sel':'');

btn.style.background=c;

if(c==='#FFFFFF'){

btn.style.border='3px solid #ddd';

}

btn.addEventListener(
'click',
()=>{

isEraser=false;

currentColor=c;

document
.querySelectorAll('.cbtn')
.forEach(
b=>
b.classList.remove('sel')
);

btn.classList.add('sel');

const borrar=
document.getElementById('btn-borra');

borrar.style.opacity='1';

borrar
.querySelector('span')
.textContent='🩹';

}
);

palEl.appendChild(btn);

}
);


/* =====================================================
   BORRADOR
===================================================== */

document
.getElementById('btn-borra')
.addEventListener(
'click',
()=>{

isEraser=!isEraser;

const b=
document.getElementById('btn-borra');

b.style.opacity=
isEraser?
'.5':
'1';

b
.querySelector('span')
.textContent=
isEraser?
'✏️':
'🩹';

if(isEraser){

document
.querySelectorAll('.cbtn')
.forEach(
x=>
x.classList.remove('sel')
);

}

}
);


/* =====================================================
   LIMPIAR
===================================================== */

document
.getElementById('btn-limpia')
.addEventListener(
'click',
()=>{

if(
!confirm(
'¿Borrar todos los colores de este dibujo?'
)
){

return;

}

colors[currentIdx]=
DRAWINGS[currentIdx]
.zones
.map(
()=>'white'
);

redraw();

toast('Dibujo limpio 🧼');

}
);


/* =====================================================
   GUARDAR
===================================================== */

document
.getElementById('btn-guarda')
.addEventListener(
'click',
()=>{

const a=
document.createElement('a');

a.download=
'coloreo-'+
Date.now()+
'.png';

a.href=
canvas.toDataURL('image/png');

a.click();

toast('¡Dibujo guardado! 🎉');

}
);


/* =====================================================
   TOAST
===================================================== */

function toast(msg){

const t=
document.getElementById('toast');

t.textContent=msg;

t.classList.add('show');

setTimeout(
()=>
t.classList.remove('show'),
2200
);

}


/* =====================================================
   INSTALACIÓN PWA
===================================================== */

let deferredPrompt=null;

const instalarBtn=
document.getElementById('instalar-app');


window.addEventListener(
'beforeinstallprompt',
e=>{

e.preventDefault();

deferredPrompt=e;

instalarBtn.style.display='block';

}
);


instalarBtn.addEventListener(
'click',
async()=>{

if(!deferredPrompt){

toast(
'Abre el menú del navegador y selecciona "Instalar aplicación".'
);

return;

}

deferredPrompt.prompt();

const resultado=
await deferredPrompt.userChoice;

console.log(
'Instalación:',
resultado.outcome
);

deferredPrompt=null;

instalarBtn.style.display='none';

}
);


window.addEventListener(
'appinstalled',
()=>{

instalarBtn.style.display='none';

deferredPrompt=null;

toast(
'¡Aplicación instalada! 🎉'
);

}
);


/* =====================================================
   SERVICE WORKER
===================================================== */

if(
'serviceWorker'
in navigator
){

window.addEventListener(
'load',
()=>{

navigator.serviceWorker
.register('./service-worker.js')

.then(
()=>
console.log(
'Service Worker registrado correctamente'
)
)

.catch(
error=>
console.error(
'Error del Service Worker:',
error
)
);

}
);

}


/* =====================================================
   INICIO
===================================================== */

window.addEventListener(
'DOMContentLoaded',
()=>{

document
.getElementById('drawing-label')
.textContent=
DRAWINGS[0].name;

resizeCanvas();

}
);


window.addEventListener(
'resize',
resizeCanvas
);

</script>

