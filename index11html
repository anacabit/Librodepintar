<style>

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  touch-action:manipulation;
}

html,body{
  width:100%;
  min-height:100%;
  background:#FFF8F0;
}

body{
  font-family:'Segoe UI',sans-serif;
  display:flex;
  flex-direction:column;
  align-items:center;
  overflow-x:hidden;
}

/* CABECERA */

header{
  width:100%;
  background:linear-gradient(135deg,#FF6B9D,#FFB347);
  padding:9px 10px 7px;
  text-align:center;
  box-shadow:0 3px 12px rgba(0,0,0,.15);
}

header h1{
  font-size:1.3rem;
  color:white;
  text-shadow:2px 2px 4px rgba(0,0,0,.2);
}

header p{
  color:rgba(255,255,255,.92);
  font-size:.76rem;
  margin-top:2px;
}

#instalar-app{
  display:none;
  margin:6px auto 0;
  border:0;
  background:white;
  color:#E91E63;
  padding:8px 16px;
  border-radius:20px;
  font-weight:bold;
  cursor:pointer;
}

/* GALERÍA */

#gallery{
  display:flex;
  gap:8px;
  padding:8px 10px 4px;
  overflow-x:auto;
  width:100%;
  scrollbar-width:none;
}

#gallery::-webkit-scrollbar{
  display:none;
}

.thumb{
  flex:0 0 56px;
  width:56px;
  height:56px;
  border-radius:11px;
  border:3px solid transparent;
  background:white;
  display:flex;
  align-items:center;
  justify-content:center;
  box-shadow:0 2px 8px rgba(0,0,0,.12);
  overflow:hidden;
  padding:3px;
  cursor:pointer;
}

.thumb.active{
  border-color:#FF6B9D;
  box-shadow:0 0 0 3px #FF6B9D40;
}

/* TÍTULO */

#drawing-label{
  font-size:.88rem;
  font-weight:700;
  color:#666;
  text-align:center;
  padding:2px 0 4px;
}

/* CANVAS */

#canvas-wrap{
  width:100%;
  padding:0 8px;
  display:flex;
  justify-content:center;
}

#paint-canvas{
  width:100%;
  max-width:560px;
  aspect-ratio:1/1;
  border-radius:14px;
  box-shadow:0 4px 20px rgba(0,0,0,.12);
  display:block;
  background:white;
  cursor:crosshair;
  touch-action:none;
}

/* PALETA */

#palette-wrap{
  width:100%;
  max-width:560px;
  padding:7px 10px 4px;
}

#palette-wrap h3{
  font-size:.66rem;
  color:#aaa;
  text-transform:uppercase;
  letter-spacing:1px;
  margin-bottom:6px;
  text-align:center;
}

#palette{
  display:grid;
  grid-template-columns:repeat(6,1fr);
  gap:6px;
}

.cbtn{
  width:100%;
  aspect-ratio:1;
  border-radius:50%;
  border:3px solid white;
  cursor:pointer;
  box-shadow:0 2px 6px rgba(0,0,0,.18);
}

.cbtn.sel{
  border-color:#333;
  box-shadow:0 0 0 3px #3333;
  transform:scale(1.08);
}

/* BOTONES */

#actions{
  display:flex;
  gap:7px;
  padding:7px 10px 13px;
  width:100%;
  max-width:560px;
}

.abtn{
  flex:1;
  padding:9px 3px;
  border:0;
  border-radius:13px;
  font-size:.72rem;
  font-weight:700;
  cursor:pointer;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:2px;
}

.abtn span{
  font-size:1.1rem;
}

#btn-borra{
  background:#FFE0B2;
  color:#E65100;
}

#btn-limpia{
  background:#FFCDD2;
  color:#C62828;
}

#btn-guarda{
  background:#C8E6C9;
  color:#2E7D32;
}

/* MENSAJE */

#toast{
  position:fixed;
  bottom:24px;
  left:50%;
  transform:translateX(-50%) translateY(60px);
  background:#333;
  color:white;
  padding:9px 20px;
  border-radius:18px;
  font-size:.85rem;
  transition:.3s;
  z-index:999;
  pointer-events:none;
}

#toast.show{
  transform:translateX(-50%) translateY(0);
}

/* PANTALLAS PEQUEÑAS */

@media(max-height:700px){

  header{
    padding:6px;
  }

  header h1{
    font-size:1.12rem;
  }

  header p{
    font-size:.7rem;
  }

  #gallery{
    padding-top:4px;
  }

  .thumb{
    width:48px;
    height:48px;
    flex-basis:48px;
  }

  #drawing-label{
    padding-bottom:2px;
  }

  #palette-wrap{
    padding-top:4px;
  }

  #actions{
    padding-bottom:7px;
  }

}

</style>
